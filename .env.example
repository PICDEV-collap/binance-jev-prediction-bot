# ==============================================================================
# Binance Prediction Markets Event-Driven Trading Bot + Jev AI Decision Engine
# Configuration Environment Variables
# ==============================================================================

# --- Binance API Configuration ---
# Your Binance API Key and Secret (Leave empty to run in Simulated Mock / Paper Trading Mode)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance Prediction REST Base URL and WebSocket Stream URL
BINANCE_PREDICTION_BASE_URL=https://fapi.binance.com
BINANCE_PREDICTION_WS_URL=wss://fstream.binance.com/ws
BINANCE_RECV_WINDOW=5000

# --- Jev AI Decision Engine Configuration ---
# API Key for Typesafe AI / Jev Engine (Leave empty to use intelligent internal heuristic fallback)
JEV_AI_API_KEY=
JEV_AI_ENDPOINT=https://api.typesafe.ai/v1/evaluate
JEV_AI_MODEL=jev-predict-v1
JEV_AI_TIMEOUT_SECONDS=3.5

# --- Risk & Execution Guard Configuration ---
# Minimum confidence required from Jev AI to trigger execution (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.80

# Maximum position size in USDT per order
MAX_POSITION_SIZE_USDT=50.0

# Default number of prediction contracts per trade
DEFAULT_ORDER_CONTRACTS=10

# Cooldown throttle (in seconds) per market round to prevent duplicate orders
COOLDOWN_SECONDS=45

# Maximum cumulative daily loss allowed before emergency circuit breaker triggers (USDT)
MAX_DAILY_LOSS_USDT=200.0

# Maximum concurrent open positions across all prediction markets
MAX_CONCURRENT_POSITIONS=5

# Maximum allowed slippage tolerance (0.03 = 3%)
SLIPPAGE_TOLERANCE=0.03

# --- Trading Mode ---
# True = Paper Trading / Dry-Run (No real funds used)
# False = Live Execution (Real funds)
PAPER_TRADING=true

# If True, enables mock market feed generator when live WS is offline or for stress testing
ENABLE_MOCK_STREAM=false

# --- Telemetry & Dashboard Server (Dedicated Ports to avoid collisions) ---
# Trading Core API / WebSocket Port (Default: 8899)
TELEMETRY_HOST=0.0.0.0
TELEMETRY_PORT=8899
LOG_LEVEL=INFO

# --- Dashboard Access & Account Identity Protection ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=trader2026
DASHBOARD_AUTH_TOKEN=jev-auth-secret-session-key-2026

# Default credentials for Web Dashboard:
# Username: admin
# Password/PIN: trader2026


